; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="洗碗时光 · 厨房场景"
run/main_scene="res://Scenes/kitchen-game.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[filesystem]

import/blender/enabled=false

[input]

game_move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
game_move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
game_move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
game_move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
game_primary={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
game_rotate={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":2)]
}
game_toggle_close={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":70)]
}
game_interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
game_tool_none={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
game_tool_sponge={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
game_tool_sprayer={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51)]
}
game_return={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
game_orders={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194306)]
}
game_menu={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
game_zoom_in={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":4)]
}
game_zoom_out={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":5)]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.16, 0.21, 0.23, 1)
