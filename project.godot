[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/penetration_slop=0.0005
jolt_physics_3d/simulation/speculative_contact_distance=0.002
jolt_physics_3d/simulation/position_steps=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.16, 0.21, 0.23, 1)
